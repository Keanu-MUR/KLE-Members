{
  "jobs": [
    {
      "functionLocation": "/jobs.js",
      "functionName": "sendReminders",
      "description": "Lesson reminders: runs hourly, sends in the hour Settings.reminderSendHour names (Europe/London).",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/jobs.js",
      "functionName": "pruneLogs",
      "description": "Nightly: delete SendLog and RateLimit rows older than Settings.sendLogRetentionDays, then compact old lessons into yearly totals (after a backup within 8 days).",
      "executionConfig": {
        "cronExpression": "0 3 * * *"
      }
    },
    {
      "functionLocation": "/jobs.js",
      "functionName": "exportBackup",
      "description": "Weekly backup: every collection to a private CSV file in the Media Manager, with an email notice.",
      "executionConfig": {
        "cronExpression": "0 2 * * 1"
      }
    }
  ]
}
