{
  "jobs": [
    {
      "functionLocation": "/jobs.js",
      "functionName": "sendReminders",
      "description": "Lesson reminders: runs hourly, sends in the hour Settings.reminderSendHour names (Europe/London).",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/jobs.js",
      "functionName": "pruneLogs",
      "description": "Delete SendLog and RateLimit rows older than Settings.sendLogRetentionDays.",
      "executionConfig": {
        "cronExpression": "0 3 * * *"
      }
    },
    {
      "functionLocation": "/jobs.js",
      "functionName": "probeJobEmail",
      "description": "Temporary: checks whether Wix triggered emails send from a scheduled job. Remove once answered.",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    }
  ]
}
