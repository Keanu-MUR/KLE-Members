// Tomorrow's reminders page and the manual test. Members may call (see
// permissions.json); requireInstructor() is the real guard.

import { requireInstructor, run, PortalError, getPupilById } from 'backend/access';
import { getLessonById } from 'backend/lesson-store';
import { loadSettings } from 'backend/settings';
import { tomorrowOverview, sendLessonReminder, jobEmailProvider } from 'backend/reminder-core';
import { pruneLogs, probeJobEmail } from 'backend/jobs';
import { queryLessons } from 'backend/lesson-store';
import { isValidEmail, toE164, londonDate } from 'public/portal-utils';
import { LESSON_STATUS } from 'public/portal-constants';

export async function getTomorrow() {
  return run(async () => {
    await requireInstructor();
    return tomorrowOverview();
  });
}

// Sends one channel again for one lesson, to the pupil's own details.
export async function resendReminder(lessonId, channel) {
  return run(async () => {
    await requireInstructor();
    const lesson = await getLessonById(lessonId);
    if (!lesson) throw new PortalError('I can’t find that lesson.', 'not-found');
    const pupil = await getPupilById(lesson.pupilId);
    if (!pupil) throw new PortalError('I can’t find that pupil.', 'not-found');
    const { settings } = await loadSettings();
    const channels = { email: channel === 'email', whatsapp: channel === 'whatsapp', guardian: false };
    const results = await sendLessonReminder(lesson, pupil, settings, channels, null);
    return { results };
  });
}

// The next planned lessons, for the test form's lesson choice.
export async function upcomingForTest() {
  return run(async () => {
    await requireInstructor();
    const today = londonDate();
    const items = await queryLessons({ from: today, status: LESSON_STATUS.PLANNED, limit: 10 });
    const out = [];
    for (const lesson of items) {
      const pupil = await getPupilById(lesson.pupilId);
      out.push({ _id: lesson._id, date: lesson.date, label: lesson.date + ', ' + (pupil ? pupil.firstName + ' ' + pupil.lastName : 'Unknown pupil') });
    }
    const { settings } = await loadSettings();
    return { lessons: out, defaults: { email: settings.instructorEmail, phone: settings.instructorWhatsApp }, provider: await jobEmailProvider(settings) };
  });
}

// The manual test from SPEC: both channels for one lesson, to the email and
// phone given (yours), logged like any other send.
export async function testReminder(lessonId, email, phone) {
  return run(async () => {
    await requireInstructor();
    const address = String(email || '').trim().toLowerCase();
    if (!isValidEmail(address)) throw new PortalError("That email address doesn't look right.");
    const number = phone ? toE164(phone) : '';
    if (phone && !number) throw new PortalError("That phone number doesn't look right.");
    const lesson = await getLessonById(lessonId);
    if (!lesson) throw new PortalError('Choose a lesson to test with.');
    const pupil = await getPupilById(lesson.pupilId);
    if (!pupil) throw new PortalError('I can’t find that pupil.', 'not-found');
    const { settings } = await loadSettings();
    const results = await sendLessonReminder(lesson, pupil, settings, { email: true, whatsapp: Boolean(number), guardian: false }, { email: address, phone: number });
    return { results };
  });
}

// Runs the pruning job now (the test script's step 8).
export async function runPrune() {
  return run(async () => {
    await requireInstructor();
    return pruneLogs();
  });
}

// Runs the probe now from a page, for comparison with the job's own row.
export async function runProbe() {
  return run(async () => {
    await requireInstructor();
    return probeJobEmail();
  });
}
