// Pupil records, instructor only. Members may call (see permissions.json);
// requireInstructor() is the real guard.

import wixData from 'wix-data';
import { authentication } from 'wix-members-backend';
import { requireInstructor, run, PortalError, getPupilById } from 'backend/access';
import { lookupMemberByEmail, pupilByEmail, insertPupil, registerMember } from 'backend/pupil-store';
import { isValidEmail, toE164, trimTo, isValidIsoDate, isValidPostcode } from 'public/portal-utils';
import { TRANSMISSION, PUPIL_STATUS } from 'public/portal-constants';

const STATUSES = Object.values(PUPIL_STATUS);

// Fields the instructor may write on the record page. memberId and
// lessonHistory are only ever set by code.
const TEXT_FIELDS = {
  firstName: 60,
  lastName: 60,
  dateOfBirth: 10,
  email: 254,
  phone: 30,
  addressLine1: 120,
  addressLine2: 120,
  town: 60,
  postcode: 10,
  licenceNumber: 20,
  emergencyContactName: 80,
  emergencyContactPhone: 30,
  theoryPassDate: 10,
  practicalTestDate: 10,
  guardianName: 80,
  guardianEmail: 254,
  instructorNotes: 4000,
  whatsAppConsentAt: 30
};
const BOOL_FIELDS = ['theoryPassed', 'reminderEmail', 'reminderWhatsApp'];

function listRow(item) {
  return {
    _id: item._id,
    firstName: item.firstName || '',
    lastName: item.lastName || '',
    transmission: item.transmission || '',
    status: item.status || '',
    postcode: item.postcode || '',
    linked: Boolean(item.memberId)
  };
}

export async function findMemberByEmail(email) {
  return run(async () => {
    await requireInstructor();
    const address = String(email || '').trim().toLowerCase();
    if (!isValidEmail(address)) throw new PortalError("That email address doesn't look right.");
    return lookupMemberByEmail(address);
  });
}

// Creates a Pupils item. If memberId is not given, the member is looked up
// by email so the pupil can log in straight away.
export async function createPupil(input) {
  return run(async () => {
    await requireInstructor();
    const data = input || {};
    const firstName = trimTo(data.firstName, 60);
    const lastName = trimTo(data.lastName, 60);
    const email = trimTo(data.email, 254).toLowerCase();
    if (!firstName || !lastName) throw new PortalError('A pupil needs a first name and a last name.');
    if (!isValidEmail(email)) throw new PortalError("That email address doesn't look right.");
    const phone = data.phone ? toE164(data.phone) : '';
    if (data.phone && !phone) throw new PortalError("That phone number doesn't look right.");
    if (await pupilByEmail(email)) throw new PortalError('There is already a pupil with that email address.');

    let memberId = trimTo(data.memberId, 64);
    if (!memberId) {
      const member = await lookupMemberByEmail(email);
      memberId = member ? member.memberId : '';
    }
    const item = await insertPupil(Object.assign({}, data, { firstName, lastName, email, phone }), memberId);
    return { pupilId: item._id, memberId, linked: Boolean(memberId) };
  });
}

export async function listPupils(filter) {
  return run(async () => {
    await requireInstructor();
    const f = filter || {};
    let query = wixData.query('Pupils').ascending('lastName').ascending('firstName').limit(200);
    if (f.status && STATUSES.includes(f.status)) query = query.eq('status', f.status);
    const search = trimTo(f.search, 60);
    if (search) {
      query = query.contains('firstName', search).or(wixData.query('Pupils').contains('lastName', search)).or(wixData.query('Pupils').contains('email', search));
    }
    const result = await query.find({ suppressAuth: true });
    const counts = {};
    for (const s of STATUSES) counts[s] = await wixData.query('Pupils').eq('status', s).count({ suppressAuth: true });
    return { items: result.items.map(listRow), counts };
  });
}

export async function getPupil(id) {
  return run(async () => {
    await requireInstructor();
    const pupil = await getPupilById(id);
    if (!pupil) throw new PortalError('That pupil record was not found.', 'not-found');
    const out = { _id: pupil._id, memberId: pupil.memberId || '', transmission: pupil.transmission || TRANSMISSION.MANUAL, status: pupil.status || PUPIL_STATUS.ACTIVE, hourlyRatePence: pupil.hourlyRatePence || null };
    Object.keys(TEXT_FIELDS).forEach((key) => { out[key] = pupil[key] || ''; });
    BOOL_FIELDS.forEach((key) => { out[key] = Boolean(pupil[key]); });
    out.guardianLinked = Boolean(pupil.guardianMemberId);
    return out;
  });
}

export async function updatePupil(id, fields) {
  return run(async () => {
    await requireInstructor();
    const pupil = await getPupilById(id);
    if (!pupil) throw new PortalError('That pupil record was not found.', 'not-found');
    const input = fields || {};
    const errors = {};
    const changes = {};

    Object.keys(TEXT_FIELDS).forEach((key) => {
      if (!Object.prototype.hasOwnProperty.call(input, key)) return;
      changes[key] = trimTo(input[key], TEXT_FIELDS[key]);
    });
    BOOL_FIELDS.forEach((key) => {
      if (Object.prototype.hasOwnProperty.call(input, key)) changes[key] = Boolean(input[key]);
    });
    if (Object.prototype.hasOwnProperty.call(input, 'transmission')) {
      changes.transmission = input.transmission === TRANSMISSION.AUTOMATIC ? TRANSMISSION.AUTOMATIC : TRANSMISSION.MANUAL;
    }
    if (Object.prototype.hasOwnProperty.call(input, 'hourlyRatePence')) {
      const rate = Number(input.hourlyRatePence);
      if (!Number.isInteger(rate) || rate < 0 || rate > 50000) errors.hourlyRatePence = 'Enter the rate in pounds and pence.';
      else changes.hourlyRatePence = rate;
    }

    if (changes.firstName === '') errors.firstName = 'A pupil needs a first name.';
    if (changes.lastName === '') errors.lastName = 'A pupil needs a last name.';
    if (changes.email !== undefined) {
      changes.email = changes.email.toLowerCase();
      if (!isValidEmail(changes.email)) errors.email = "That email address doesn't look right.";
      else {
        const other = await pupilByEmail(changes.email);
        if (other && other._id !== pupil._id) errors.email = 'Another pupil already uses that email address.';
      }
    }
    ['phone', 'emergencyContactPhone'].forEach((key) => {
      if (changes[key]) {
        const e164 = toE164(changes[key]);
        if (!e164) errors[key] = "That phone number doesn't look right.";
        else changes[key] = e164;
      }
    });
    ['dateOfBirth', 'theoryPassDate', 'practicalTestDate'].forEach((key) => {
      if (changes[key] && !isValidIsoDate(changes[key])) errors[key] = 'Use the date picker, or YYYY-MM-DD.';
    });
    if (changes.postcode) {
      changes.postcode = changes.postcode.toUpperCase().replace(/\s+/g, ' ');
      if (!isValidPostcode(changes.postcode)) errors.postcode = "That postcode doesn't look right.";
    }
    if (changes.guardianEmail && !isValidEmail(changes.guardianEmail)) errors.guardianEmail = "That email address doesn't look right.";
    if (changes.reminderWhatsApp === true && !pupil.reminderWhatsApp) changes.whatsAppConsentAt = new Date().toISOString();
    if (changes.reminderWhatsApp === false) changes.whatsAppConsentAt = '';

    if (Object.keys(errors).length) return { saved: false, errors };
    const updated = await wixData.update('Pupils', Object.assign({}, pupil, changes), { suppressAuth: true });
    return { saved: true, errors: {}, updatedAt: updated._updatedDate ? new Date(updated._updatedDate).toISOString() : '' };
  });
}

export async function setPupilStatus(id, status) {
  return run(async () => {
    await requireInstructor();
    if (!STATUSES.includes(status)) throw new PortalError('Choose active, passed or inactive.');
    const pupil = await getPupilById(id);
    if (!pupil) throw new PortalError('That pupil record was not found.', 'not-found');
    await wixData.update('Pupils', Object.assign({}, pupil, { status }), { suppressAuth: true });
    return { status };
  });
}

// Sends Wix's set-password email so the pupil can log in. Also links the
// member if the record has none yet and one exists for the email.
export async function sendLoginLink(id) {
  return run(async () => {
    await requireInstructor();
    const pupil = await getPupilById(id);
    if (!pupil) throw new PortalError('That pupil record was not found.', 'not-found');
    if (!isValidEmail(pupil.email)) throw new PortalError('Add a valid email address to the record first.');
    let memberId = pupil.memberId || '';
    if (!memberId) {
      const member = await lookupMemberByEmail(pupil.email);
      if (member) {
        memberId = member.memberId;
        await wixData.update('Pupils', Object.assign({}, pupil, { memberId }), { suppressAuth: true });
      }
    }
    if (!memberId) throw new PortalError('There is no member account for that email yet. Convert the enquiry, or create the member first.');
    await authentication.sendSetPasswordEmail(pupil.email);
    return { sent: true, memberId };
  });
}

// ---- Guardian login ---------------------------------------------------

async function guardianOfAnotherPupil(memberId, pupilId) {
  const result = await wixData.query('Pupils').eq('guardianMemberId', memberId).ne('_id', pupilId).limit(1).find({ suppressAuth: true });
  return result.items[0] || null;
}

// Gives a guardian a read-only login to this pupil's pages: an existing
// member by email, or a new member sent Wix's set-password email. One
// guardian login per pupil, and a login can only watch one pupil.
export async function linkGuardian(id, email) {
  return run(async () => {
    await requireInstructor();
    const pupil = await getPupilById(id);
    if (!pupil) throw new PortalError('That pupil record was not found.', 'not-found');
    const address = String(email || '').trim().toLowerCase();
    if (!isValidEmail(address)) throw new PortalError("That email address doesn't look right.");
    if (address === String(pupil.email || '').toLowerCase()) throw new PortalError("That is the pupil's own address; a guardian needs their own.");
    const other = await pupilByEmail(address);
    if (other) throw new PortalError('That address belongs to a pupil, so it cannot be a guardian login.');
    let member = await lookupMemberByEmail(address);
    let created = false;
    if (member && (await guardianOfAnotherPupil(member.memberId, pupil._id))) {
      throw new PortalError('That login already watches another pupil; a guardian login can only watch one.');
    }
    let memberId = member ? member.memberId : '';
    if (!memberId) {
      memberId = await registerMember(address, { firstName: pupil.guardianName || 'Guardian', lastName: '' });
      if (!memberId) throw new PortalError('Could not create the guardian login. Try again in a moment.');
      created = true;
    }
    await wixData.update('Pupils', Object.assign({}, pupil, { guardianMemberId: memberId, guardianEmail: address }), { suppressAuth: true });
    let sent = false;
    try {
      await authentication.sendSetPasswordEmail(address);
      sent = true;
    } catch (error) {
      console.warn('[portal] guardian set-password email did not send', error && error.message ? error.message : error);
    }
    return { linked: true, created, sent, email: address };
  });
}

// Takes the login away; the guardian's member account stays.
export async function unlinkGuardian(id) {
  return run(async () => {
    await requireInstructor();
    const pupil = await getPupilById(id);
    if (!pupil) throw new PortalError('That pupil record was not found.', 'not-found');
    await wixData.update('Pupils', Object.assign({}, pupil, { guardianMemberId: '' }), { suppressAuth: true });
    return { linked: false };
  });
}

export async function sendGuardianLoginLink(id) {
  return run(async () => {
    await requireInstructor();
    const pupil = await getPupilById(id);
    if (!pupil) throw new PortalError('That pupil record was not found.', 'not-found');
    if (!pupil.guardianMemberId || !isValidEmail(pupil.guardianEmail)) throw new PortalError('Link a guardian login first.');
    await authentication.sendSetPasswordEmail(pupil.guardianEmail);
    return { sent: true, email: pupil.guardianEmail };
  });
}
